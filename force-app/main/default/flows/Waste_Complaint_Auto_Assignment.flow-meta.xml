<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <description>Assigns the most suitable service team based on complaint location and severity.</description>
    <interviewLabel>Waste Complaint Auto Assignment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Waste_Complaint_Auto_Assignment</label>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <name>Find_Available_Team</name>
        <label>Find Available Team</label>
        <locationX>176</locationX>
        <locationY>176</locationY>
        <connector>
            <targetReference>Has_Available_Team</targetReference>
        </connector>
        <object>Service_Team__c</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Location__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Location__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>Team_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Available</stringValue>
            </value>
        </filters>
        <outputReference>Selected_Team</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Location__c</queriedFields>
        <queriedFields>Total_Assignments__c</queriedFields>
        <queriedFields>Team_Status__c</queriedFields>
        <sortField>Total_Assignments__c</sortField>
        <sortOrder>Asc</sortOrder>
    </recordLookups>
    <variables>
        <name>Selected_Team</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Service_Team__c</objectType>
    </variables>
    <decisions>
        <name>Has_Available_Team</name>
        <label>Has Available Team</label>
        <locationX>176</locationX>
        <locationY>320</locationY>
        <defaultConnector>
            <targetReference>No_Action_Required</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Team or Not Critical</defaultConnectorLabel>
        <rules>
            <name>Team_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Selected_Team.Id</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Update_Complaint_Assignment</targetReference>
            </connector>
            <label>Team Found</label>
        </rules>
        <rules>
            <name>Critical_No_Team</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Severity__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Critical</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Escalate_Critical_Complaint</targetReference>
            </connector>
            <label>Critical No Team</label>
        </rules>
    </decisions>
    <recordUpdates>
        <name>Update_Complaint_Assignment</name>
        <label>Update Complaint Assignment</label>
        <locationX>176</locationX>
        <locationY>512</locationY>
        <inputAssignments>
            <field>Assigned_Team__c</field>
            <value>
                <elementReference>Selected_Team.Id</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Assigned</stringValue>
            </value>
        </inputAssignments>
        <object>Waste_Complaint__c</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
    </recordUpdates>
    <recordUpdates>
        <name>Escalate_Critical_Complaint</name>
        <label>Escalate Critical Complaint</label>
        <locationX>440</locationX>
        <locationY>512</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <stringValue>Escalated</stringValue>
            </value>
        </inputAssignments>
        <object>Waste_Complaint__c</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
    </recordUpdates>
    <recordUpdates>
        <name>No_Action_Required</name>
        <label>No Action Required</label>
        <locationX>176</locationX>
        <locationY>704</locationY>
        <inputAssignments>
            <field>Status__c</field>
            <value>
                <elementReference>$Record.Status__c</elementReference>
            </value>
        </inputAssignments>
        <object>Waste_Complaint__c</object>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
    </recordUpdates>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Find_Available_Team</targetReference>
        </connector>
        <object>Waste_Complaint__c</object>
        <recordTriggerType>Create</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
